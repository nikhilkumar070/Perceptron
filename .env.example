# Database: Leave empty for local SQLite, or set to Neon PostgreSQL connection string
# Example Neon URL: postgresql://neondb_owner:password@ep-cool-subdomain.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CORS & Frontend Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Cookie Security (set to true for HTTPS on Render, false for local HTTP)
COOKIE_SECURE=false

# Resume Intelligence: "local" (zero-key local engine) or "openai"
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Frontend API Base URL (used by Vite frontend during build or local overrides)
VITE_API_URL=http://127.0.0.1:8001/api
